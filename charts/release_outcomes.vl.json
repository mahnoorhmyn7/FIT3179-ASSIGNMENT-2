
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Reported outcomes of 27 Australian zoo-associated conservation translocation study records.",
  "width": "760",
  "height": 290,
  "data": {
    "url": "data/zoo_wildlife_releases.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum['transl.country'] === 'Australia'"
    },
    {
      "calculate": "datum.outcome == null || datum.outcome === '' || datum.outcome === 'NA' ? 'Not reported' : datum.outcome",
      "as": "outcome_label"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "study_count"
        }
      ],
      "groupby": ["outcome_label"]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "study_count",
      "type": "quantitative",
      "title": "Number of study records",
      "scale": {
        "zero": true
      },
      "axis": {
        "tickMinStep": 1,
        "gridColor": "#e8ece6"
      }
    },
    "y": {
      "field": "outcome_label",
      "type": "nominal",
      "title": null,
      "sort": [
        "Success",
        "Failure",
        "Undetermined",
        "Not reported"
      ]
    },
    "color": {
      "field": "outcome_label",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Success",
          "Failure",
          "Undetermined",
          "Not reported"
        ],
        "range": [
          "#55765b",
          "#bd6848",
          "#c3ad75",
          "#a8aea8"
        ]
      }
    },
    "tooltip": [
      {
        "field": "outcome_label",
        "type": "nominal",
        "title": "Reported outcome"
      },
      {
        "field": "study_count",
        "type": "quantitative",
        "title": "Study records"
      }
    ]
  },
  "config": {
    "background": "#fffefa",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
